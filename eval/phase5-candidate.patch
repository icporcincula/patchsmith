diff --git a/context.py b/context.py
new file mode 100644
index 0000000..acb0e57
--- /dev/null
+++ b/context.py
@@ -0,0 +1,75 @@
+"""Bounded source hints and extracted test failures for the local model."""
+
+import re
+
+SYMBOL = re.compile(
+    r"^(?:async )?(?:def|class)\s+([A-Za-z_$][\w$]*)"
+    r"|^(?:export\s+(?:default\s+)?)?(?:async\s+)?(?:function|class)\s+([A-Za-z_$][\w$]*)"
+    r"|^export\s+(?:const|let|var)\s+([A-Za-z_$][\w$]*)"
+)
+FAILURE = re.compile(
+    r"^(?:FAIL:|ERROR:|FAILED |ERROR |E\s+|AssertionError\b|[A-Za-z]*Error:|"
+    r"\s*(?:not ok\b|error:|expected:|actual:|operator:))"
+)
+
+
+def repo_map(session):
+    """Use existing visibility/jail rules; never import or execute source."""
+    lines = []
+    seen = set()
+    read_bytes = 0
+    length = 0
+    try:
+        names = session.visible_files()
+    except (OSError, ValueError, RuntimeError):
+        return ""
+    for index, name in enumerate(names):
+        if index >= 100 or length >= 1800:
+            lines.append("... map truncated ...")
+            break
+        parts = name.split("/")
+        display = name if len(parts) <= 4 else "/".join(parts[:4]) + "/..."
+        if display in seen:
+            continue
+        seen.add(display)
+        symbols = []
+        if len(parts) <= 4 and name.endswith((".py", ".js", ".jsx", ".ts", ".tsx")) and read_bytes < 131072:
+            try:
+                path = session.safe(name)
+                if path.is_file() and path.stat().st_size <= 65536:
+                    with path.open("rb") as stream:
+                        data = stream.read(min(16384, 131072 - read_bytes))
+                    read_bytes += len(data)
+                    if b"\0" not in data:
+                        for line in data.decode("utf-8", "replace").splitlines():
+                            match = SYMBOL.match(line)
+                            if match:
+                                symbols.append(next(value for value in match.groups() if value)[:80])
+                                if len(symbols) == 6:
+                                    break
+            except (OSError, ValueError, RuntimeError):
+                pass
+        # JSON-style escaping keeps unusual names on a single display line.
+        display = display.encode("unicode_escape").decode("ascii")[:240]
+        line = display + (" :: " + ", ".join(symbols) if symbols else "")
+        lines.append(line)
+        length += len(line) + 1
+    return "\n".join(lines)[:2000]
+
+
+def failure_digest(output):
+    """Prepend extracted evidence, preserving the exit line and original output."""
+    if not output.startswith("exit ") or output.startswith("exit 0\n"):
+        return output
+    first, _, body = output.partition("\n")
+    selected = []
+    for line in body.splitlines():
+        if FAILURE.match(line):
+            value = line.strip()[:240]
+            if value not in selected:
+                selected.append(value)
+            if sum(len(value) + 1 for value in selected) >= 900:
+                break
+    if not selected:
+        return output
+    return first + "\nFailure digest (extracted lines):\n" + "\n".join(selected)[:1000] + "\n\nOriginal test output:\n" + body
diff --git a/tests/test_context.py b/tests/test_context.py
