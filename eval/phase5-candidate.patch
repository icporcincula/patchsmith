@@ -0,0 +1,74 @@
+"""Visibility, bounded context and model-facing failure evidence."""
+
+import pytest
+
+from patchsmith_plugin.context import failure_digest, repo_map
+from patchsmith_plugin.tools import Session
+from test_loop import FINISH, TEST, invoke, scripted, test_command
+
+
+def test_map_obeys_visibility_and_collects_symbols(repo):
+    (repo / ".gitignore").write_text("private.py\n", encoding="utf-8")
+    (repo / "private.py").write_text("def secret(): pass\n", encoding="utf-8")
+    (repo / "app.py").write_text("def visible():\n    def nested(): pass\n", encoding="utf-8")
+    (repo / "module.js").write_text("export function hello() {}\nexport const answer = 42;\n", encoding="utf-8")
+    output = repo_map(Session(repo, ""))
+    assert "app.py :: visible" in output and "nested" not in output
+    assert "module.js :: hello, answer" in output
+    assert "private.py" not in output and "secret" not in output and ".git/" not in output
+
+
+def test_map_bounds_depth_source_reads_and_output(repo):
+    deep = repo / "one/two/three/four/five.py"
+    deep.parent.mkdir(parents=True)
+    deep.write_text("def too_deep(): pass\n", encoding="utf-8")
+    (repo / "large.py").write_text("def oversized(): pass\n" + "#" * 65536, encoding="utf-8")
+    output = repo_map(Session(repo, ""))
+    assert "one/two/three/four/..." in output and "too_deep" not in output
+    assert "large.py" in output and "oversized" not in output
+    for index in range(130):
+        (repo / ("file_" + str(index) + "x" * 70 + ".py")).write_text("", encoding="utf-8")
+    output = repo_map(Session(repo, ""))
+    assert len(output) <= 2000 and "map truncated" in output
+
+
+def test_map_never_reads_outside_link(repo, tmp_path):
+    outside = tmp_path / "outside.py"
+    outside.write_text("def must_not_leak(): pass\n", encoding="utf-8")
+    try:
+        (repo / "linked.py").symlink_to(outside)
+    except OSError:
+        pytest.skip("Creating links is unavailable")
+    assert "must_not_leak" not in repo_map(Session(repo, ""))
+
+
+@pytest.mark.parametrize("body, expected", [
+    ("FAIL: test_value (test_app.Example)\ntrace detail\nAssertionError: 1 != 2", "FAIL: test_value"),
+    ("long trace\nE       assert 1 == 2\nFAILED tests/test_app.py::test_value", "E       assert 1 == 2"),
+    ("TAP version 13\nnot ok 1 - clamp\n  error: wrong bound\n  expected: 2", "not ok 1 - clamp"),
+])
+def test_digest_preserves_exit_and_original(body, expected):
+    raw = "exit 1\n" + body
+    output = failure_digest(raw)
+    assert output.startswith("exit 1\nFailure digest")
+    assert expected in output.split("Original test output:")[0]
+    assert output.endswith(body)
+
+
+def test_digest_does_not_invent_failures():
+    for raw in ("exit 0\nOK", "No test command configured.", "exit 2\nunknown failure"):
+        assert failure_digest(raw) == raw
+    output = failure_digest("exit 1\n" + "\n".join("AssertionError: " + str(i) + "x" * 500 for i in range(100)))
+    assert len(output.split("Original test output:")[0]) < 1100
+
+
+def test_model_receives_map_and_digest_without_changing_test_facts(repo):
+    command = test_command("-c", "print('FAIL: test_value'); print('AssertionError: wrong value'); raise SystemExit(1)")
+    with scripted(TEST, FINISH) as (url, requests):
+        result = invoke(repo, url, test_command=command)
+    user = requests[0]["messages"][1]["content"]
+    assert "Repository map" in user and "app.py" in user
+    reply = requests[1]["messages"][-1]["content"]
+    assert reply.startswith("exit 1\nFailure digest")
+    assert result["status"] == "blocked" and result["reason"] == "tests_failed"
+    assert result["attempt_history"][0]["test_output"].startswith("exit 1\nFAIL:")
